            "__resolveType": "site/sections/LandingPage.tsx",
            "section_1": {
              "title": "Emerging Venture Capital Fellows",
              "subtitle": "The community for future Venture Capital leaders in Latin America 🚀",
              "text": "In venture capital, talent isn't enough. You need access to industry leaders, strategic connections, and the knowledge that opens doors to leadership positions. That's why we created Emerging Venture Capital Fellows (EVCF): an exclusive community designed to accelerate your career within the ecosystem.",
              "button": {
                "text": "I want to be a fellow",
                "url": "https://criteriosevcf.carrd.co/"
              }
            },
            "section_2": {
              "title": "What you find at Fellowship",
              "button": {
                "text": "Subscribe",
                "url": "https://criteriosevcf.carrd.co/"
              },
              "option": [
                {
                  "text": "✓ Real Networking: Build meaningful relationships with fellows and industry leaders."
                },
                {
                  "text": "✓ In-depth content: Participate in discussions on essential industry topics, from the Partner journey to liquidity scenarios."
                },
                {
                  "text": "✓ Access to big names: Interact closely with Managing Partners of the most relevant funds in Brazil and around the world."
                },
                {
                  "text": "✓ Exclusive quarterly agenda: In-person and online events that combine learning, inspiration, and strategic connections."
                }
              ]
            },
            "section_3": {
              "title": "Be part of the future of Venture Capital in Latin America",
              "subtitle": "Confirmed schedule:",
              "button": {
                "text": "I want to be a fellow",
                "url": "https://criteriosevcf.carrd.co/"
              },
              "option": [
                {
                  "text": "📍10/21 → Round Table with Shu Nyatta (Founder & Managing Partner at Bicycle Capital + Global Board Member at Endeavor) "
                },
                {
                  "text": "📍 11/11 → VC Get Together: Exclusive Happy Hour at Exímia Bar + automatic access to Exímia Private Members"
                },
                {
                  "text": "📍 10/12 → Ask Me Anything with Eric Acher (Co-founder & Managing Partner of Monashees)"
                }
              ]
            },
            "section_4": {
              "title": "Who can participate?",
