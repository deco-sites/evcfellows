{
  "name": "blog post page",
  "path": "/blog/:slug",
  "sections": [
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "Main Header"
      }
    },
    {
      "__resolveType": "site/sections/BlogPost.tsx",
      "page": {
        "__resolveType": "blog/loaders/BlogPostPage.ts",
        "slug": {
          "__resolveType": "website/functions/requestToParam.ts",
          "param": "slug"
        }
      },
      "topImage": {
        "src": "https://decoims.com/evcfellows/1d636d44-083c-4b21-892d-f7d5e9203e2f/22c0744b302b2dd1.svg",
        "alt": "arrow image",
        "height": 143,
        "width": 1036
      },
      "twitterIcon": {
        "src": "https://decoims.com/evcfellows/0ed61d79-b704-4ef3-8ab7-2d69af0e699b/6dd6aa048d012ddf.png",
        "alt": "twitter icon",
        "width": 47,
        "height": 47
      },
      "linkedinIcon": {
        "src": "https://decoims.com/evcfellows/6e998742-2240-468e-9e32-ff0e7e7b996d/7132b9ffcea7f7bd.webp",
        "alt": "linkedin",
        "width": 47,
        "height": 47
      },
      "link": "/blog",
      "linkText": "OLDER POSTS  >"
    },
    {
      "__resolveType": "website/sections/Rendering/Lazy.tsx",
      "section": {
        "__resolveType": "Footer"
      }
    }
  ],
  "seo": {
    "__resolveType": "website/sections/Seo/SeoV2.tsx"
  },
  "__resolveType": "website/pages/Page.tsx"
}
